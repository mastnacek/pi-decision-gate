{
  "name": "pi-decision-gate",
  "version": "0.1.0",
  "description": "Pi agent extension that intercepts model actions and requires user approval with model attribution, historical model insights, and fast Jev risk assessment via OpenRouter with CZK tracking.",
  "type": "module",
  "license": "MIT",
  "author": "mastnacek",
  "homepage": "https://github.com/mastnacek/pi-decision-gate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastnacek/pi-decision-gate.git"
  },
  "bugs": {
    "url": "https://github.com/mastnacek/pi-decision-gate/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "decision-gate",
    "approval",
    "typesafe",
    "jev",
    "openrouter"
  ],
  "files": [
    "README*.md",
    "LICENSE",
    "*.ts",
    "models.json",
    "scripts",
    "package.json"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "fetch-models": "node scripts/fetch-models.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "typescript": "^5.8.3"
  }
}
